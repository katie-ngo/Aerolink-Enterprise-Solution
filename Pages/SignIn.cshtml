@page
@model Aerolink_Enterprise_Solution.Pages.SignInModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="row justify-content-center my-5">
    <div class="col-11 col-sm-8 col-md-6 col-lg-4">
        <div class="card shadow-sm border rounded-3">
            <div class="card-body p-4 p-md-5">


                <div>
                    <h2 class="h4 fw-bold mb-1">TurnaroundHub</h2>
                    <p class="text-muted small">Sign in to your account</p>
                </div>

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <input asp-for="Email" class="form-control" placeholder="e.g. s.mitchell@company.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="EmployeeId" class="form-label">Employee ID</label>
                        <input asp-for="EmployeeId" class="form-control" placeholder="e.g. 1" />
                        <span asp-validation-for="EmployeeId" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <div class="form-group form-check">
                            <input type="checkbox" class="form-check-input" id="exampleCheck1">
                            <label class="form-check-label" for="exampleCheck1">Remember me?</label>
                        </div>
                    </div>



                    <button type="submit" class="btn btn-primary">Submit</button>
                    @if(Model.ErrorMessage != null)
                    {
                        <div class="alert alert-danger mt-3" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }
                </form>



            </div>
        
        </div>
    </div>
</div>






