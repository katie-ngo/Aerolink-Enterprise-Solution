@page
@model Aerolink_Enterprise_Solution.Pages.BaggageManagementModel
@{
    ViewData["Title"] = "Loading status report";
}
<div class="mb-4">
    <h1>Baggage Operations</h1>

    <a asp-page="/BaggageManagement/BaggageSpecialHandling"
       class="btn btn-primary me-2">
        Special Handling
    </a>

    <a asp-page="/BaggageManagement/ReportBaggageException"
       class="btn btn-warning">
        Report Baggage Problem
    </a>
</div>

@if (!string.IsNullOrEmpty(Model.FeedbackMessage))
{
    <div class="alert alert-@Model.FeedbackType alert-dismissible fade show" role="alert">
        <strong>Notification:</strong> @Model.FeedbackMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<h1>Loading status report</h1>

<form method="get" class="mb-4">
    <label asp-for="FlightId" class="form-label">Select a flight</label>

    <select asp-for="FlightId" class="form-select mb-2">
        <option value="">Choose a flight</option>
        @foreach (var flight in Model.Flights)
        {
            <option value="@flight.FlightId">
                @flight.FlightLabel — @flight.FlightNumber —
                @flight.DepartureAirport to @flight.ArrivalAirport —
                @flight.ScheduledDepartureUtc.ToString("dd MMM yyyy HH:mm") UTC
            </option>
        }
    </select>

    <button type="submit" class="btn btn-primary">View report</button>
</form>

@if (Model.SelectedFlight is null)
{
    <p>Select a flight to view its baggage loading report.</p>
}
else
{
    <h2>@Model.SelectedFlight.FlightNumber</h2>

    @if (Model.SelectedFlight.LoadingStatus == "Completed")
    {
        <a asp-page="/BaggageManagement/LoadingSummary"
           asp-route-FlightId="@Model.FlightId"
           class="btn btn-primary mb-3">
            View final summary
        </a>
    }
    else if (User.IsInRole("BG_Supervisor"))
    {
        <a asp-page="/BaggageManagement/CompleteLoading"
           asp-route-FlightId="@Model.FlightId"
           class="btn btn-success mb-3">
            Complete loading
        </a>
    }
    <p>
        @Model.SelectedFlight.DepartureAirport to
        @Model.SelectedFlight.ArrivalAirport |
        Loading status: <span class="badge bg-secondary">@Model.SelectedFlight.LoadingStatus</span>
    </p>

    <div>
        <div>
            <h3 class ="mb-0">Confirm Bags</h3>
        </div>

        <div "card-body">
            <form method="post" asp-page-handler="VerifyBag" class="row g-2 align-items-center">
                <input type="hidden" asp-for="FlightId" />
                <div>
                    <input asp-for="EnteredBagTag" class="form-control" placeholder="Add Bag Tag (e.g. DEMO-102-001)" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">Verify &amp; Confirm Load</button>
                </div>
            </form>
            <small class="text-muted">Must belong to @Model.SelectedFlight.FlightNumber and have no open exceptions.</small>
        </div>
    </div>

    <table class="table table-bordered">
        <caption class="caption-top">Manifest and loading totals</caption>
        <thead>
            <tr>
                <th scope="col">Expected bags</th>
                <th scope="col">Loaded</th>
                <th scope="col">Approved not to load</th>
                <th scope="col">Outstanding</th>
                <th scope="col">Open exceptions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.ExpectedCount</td>
                <td>@Model.LoadedCount</td>
                <td>@Model.ApprovedNotToLoadCount</td>
                <td>@Model.OutstandingCount</td>
                <td>@Model.OpenExceptionCount</td>
            </tr>
        </tbody>
    </table>

    @if (Model.ExpectedCount == 0)
    {
        <div class="alert alert-warning">
            Readiness cannot be confirmed: no manifest bags are recorded.
        </div>
    }
    else if (Model.ReadyForCompletion)
    {
        <div class="alert alert-success">
            Ready for completion: every expected bag is accounted for
            and no exception remains open.
        </div>
    }
    else
    {
        <div class="alert alert-warning">
            Not ready for completion:
            @Model.OutstandingCount outstanding bags and
            @Model.OpenExceptionCount open exceptions.
        </div>
    }

    <h3>Recorded outcomes</h3>
    @if (Model.ExpectedCount == 0)
    {
        <p>No manifest bags are recorded for this flight.</p>
    }
    else
    {
        <ul>
            @foreach (var outcome in Model.Bags.GroupBy(b => b.Outcome))
            {
                <li>@outcome.Key: @outcome.Count()</li>
            }
        </ul>
    }





    <h3>Baggage Manifest</h3>
    @if (Model.ExpectedCount == 0)
    {
        <p>No baggage found on manifest</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Bag Tag ID</th>
                        <th scope="col">Baggage type</th>
                        <th scope="col">Handling instructions</th>
                        <th scope="col">Loading Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bag in Model.Bags)
                    {
                        <tr>
                            <td>@bag.Tag</td>
                            <td>
                                @if (bag.HandlingType != "Standard")
                                {
                                    <span class="badge bg-warning text-dark">⚠️ @bag.HandlingType</span>
                                }
                                else
                                {
                                    <span class="badge bg-dark text-light">Standard</span>
                                }
                            </td>
                            <td>@bag.HandlingInstruction</td>
                            <td>
                                @if (bag.Outcome == "Loaded")
                                {
                                    <span class="badge bg-success">Loaded</span>
                                }
                                else if (bag.Outcome == "ApprovedNotToLoad")
                                {
                                    <span class="badge bg-danger">Approved Not To Load</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Pending</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h3>Open exceptions</h3>
    @if (Model.OpenExceptionCount == 0)
    {
        <p>No open exceptions are recorded.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th scope="col">Bag tag</th>
                        <th scope="col">Category</th>
                        <th scope="col">Description</th>
                        <th scope="col">Decision reason</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var exception in Model.Exceptions.Where(e => e.Status == "Open"))
                    {
                        var bag = Model.Bags.FirstOrDefault(b => b.BagId == exception.BagId);
                        <tr>
                            <td>
                                @(bag?.Tag ?? $"Bag ID {exception.BagId}")

                                @if (User.IsInRole("BG_Supervisor"))
                                {
                                    <a asp-page="/BaggageManagement/ResolveBaggageException"
                                       asp-route-ExceptionId="@exception.ExceptionId"
                                       class="btn btn-outline-primary btn-sm ms-2">
                                        Review
                                    </a>
                                }
                            </td>
                            <td>@exception.Category</td>
                            <td>@exception.Description</td>
                            <td>@exception.DecisionReason</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="text-muted">
        Report updated:
        @DateTime.UtcNow.ToString("HH:mm:ss") UTC.
        Automatically refreshes every 15 seconds when enabled.
    </p>

    <label class="form-check">
        <input id="autoRefresh"
               type="checkbox"
               class="form-check-input"
               checked />
        <span class="form-check-label">Automatic refresh</span>
    </label>

    <script>
        const flightSelector = document.getElementById("FlightId");
        const displayedFlightId = flightSelector.value;

        setInterval(() => {
            const enabled = document.getElementById("autoRefresh").checked;
            const selectionUnchanged =
                flightSelector.value === displayedFlightId;

            if (enabled && selectionUnchanged && !document.hidden) {
                window.location.reload();
            }
        }, 15000);
    </script>
}