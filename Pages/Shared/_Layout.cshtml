@using System.Security.Claims


<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aerolink_Enterprise_Solution</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aerolink_Enterprise_Solution.styles.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
        <header>
            <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3"
            style="background-color: #e3f2fd;">
                <div class="container">
                    <a href="#" class="navbar-brand">
                        <img src="~/images/plane.png" height="80" alt="AeroLink">
                    </a>
                    <strong  class="navbar-brand" asp-area="" asp-page="/Index">AeroLink</strong>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Menu
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-page="/TurnaroundPlanning">Turnaround Planning & Resource Allocation</a></li>
                                <li><a class="dropdown-item" asp-page="/BaggageManagement">Baggage Management</a></li>
                                <li><a class="dropdown-item" asp-page="/DepartureReadiness">Departure Readiness & Turnaround Completion</a></li>
                            </ul>
                        </li>


                          
                        <div class="text-end">                            
                            <button class="btn btn-outline-primary me-2">
                                <a class="nav-link text-red" asp-area="" asp-page="/Register">Register</a>
                            </button>  
                            <button class="btn btn-outline-primary me-2">
                                <a class="nav-link text-red" asp-area="" asp-page="/SignIn">Sign In</a>
                            </button>  
                        </div>
                       }

 
                    </div>
                </div>
            </nav>
        </header>
        <div class="container flex-grow-1">

            <main role="main" class="pb-3">
                @RenderBody()
            </main>

        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Aerolink_Enterprise_Solution - <a asp-area="" asp-page="/Privacy">Privacy</a>
            </div>
        </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
